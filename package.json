{
  "name": "bandwidth-reservations",
  "private": true,
  "type": "module",
  "workspaces": [
    "platform/runtime",
    "platform/migrate",
    "platform/examples/canary",
    "slices/link",
    "slices/sec/iam-lib",
    "slices/sec/key-service",
    "slices/sec/identity-owner",
    "slices/sec/edge-auth",
    "slices/sec/audit",
    "slices/sec/test-owner",
    "slices/account/owner",
    "slices/account/booking-api",
    "slices/rate/common",
    "slices/rate/ingestion",
    "slices/rate/rating-owner",
    "contracts/suites"
  ],
  "scripts": {
    "check": "npm run -s check:boundaries && npm run -s lint && npm run -s typecheck && npm run -s test:unit && npm run -s test:contracts",
    "check:boundaries": "python3 tools/check_boundaries.py",
    "ci": "bash tools/ci.sh",
    "conformance": "python3 tools/conformance.py",
    "conformance:write": "python3 tools/conformance.py --write",
    "coverage": "python3 tools/impact.py coverage",
    "dev:down": "docker compose -f platform/dev/docker-compose.yml down -v",
    "dev:up": "docker compose -f platform/dev/docker-compose.yml up -d --wait",
    "impact": "python3 tools/impact.py",
    "lint": "eslint platform slices contracts",
    "lint:fix": "eslint --fix platform slices contracts",
    "measure": "LINK_MEASURE=1 SEC_MEASURE=1 npm run -s test:link && LINK_MEASURE=1 SEC_MEASURE=1 npm run -s test:sec",
    "mutation:account": "stryker run tools/mutation/account.stryker.json",
    "mutation:link": "stryker run tools/mutation/link.stryker.json",
    "mutation:rate": "stryker run tools/mutation/rate.stryker.json",
    "plan": "python3 tools/plan_graph.py",
    "plan:write": "python3 tools/plan_graph.py --write",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "progress": "npm run -s plan && npm run -s conformance",
    "progress:write": "npm run -s plan:write && npm run -s conformance:write",
    "specs": "python3 tools/check_specs.py",
    "specs:regen": "python3 tools/check_specs.py --regen",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:account": "node --test --test-concurrency=1 'slices/account/*/test/*.test.ts'",
    "test:contracts": "node --test --test-concurrency=1 'contracts/*/test/contract.*.test.ts' 'platform/*/test/contract.*.test.ts' 'slices/*/test/contract.*.test.ts' 'slices/*/*/test/contract.*.test.ts'",
    "test:integration": "npm run -s test:platform:integration && npm run -s test:link:integration",
    "test:link": "node --test --test-concurrency=1 'slices/link/test/*.test.ts'",
    "test:link:integration": "node --test --test-concurrency=1 'slices/link/test/integration/*.test.ts'",
    "test:platform": "node --test --test-concurrency=1 'platform/*/test/*.test.ts' 'platform/examples/*/test/*.test.ts'",
    "test:platform:integration": "node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit 'platform/*/test/integration/*.test.ts' 'platform/examples/*/test/integration/*.test.ts'",
    "test:rate": "node --test --test-concurrency=1 'slices/rate/*/test/*.test.ts'",
    "test:sec": "node --test --test-concurrency=1 'slices/sec/*/test/*.test.ts' 'slices/sec/test/*.test.ts'",
    "test:unit": "npm run -s test:platform && npm run -s test:link && npm run -s test:sec && npm run -s test:account && npm run -s test:rate",
    "typecheck": "npm run -s typecheck:platform && npm run -s typecheck:link && npm run -s typecheck:sec && npm run -s typecheck:account && npm run -s typecheck:rate && npm run -s typecheck:contracts",
    "typecheck:account": "tsc --noEmit -p slices/account",
    "typecheck:contracts": "tsc --noEmit -p contracts/suites",
    "typecheck:link": "tsc --noEmit -p slices/link",
    "typecheck:platform": "tsc --noEmit -p platform",
    "typecheck:rate": "tsc --noEmit -p slices/rate",
    "typecheck:sec": "tsc --noEmit -p slices/sec"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.10",
    "eslint": "10.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.1",
    "@stryker-mutator/core": "9.6.1"
  },
  "engines": {
    "node": ">=24"
  }
}
