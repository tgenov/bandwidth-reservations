{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run -s test:rate"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "disableTypeChecks": false,
  "mutate": [
    "slices/rate/common/src/ela.ts",
    "slices/rate/common/src/time.ts",
    "slices/rate/rating-owner/src/attribution/stage-a.ts",
    "slices/rate/rating-owner/src/catalogue/replica.ts",
    "slices/rate/rating-owner/src/rating/owner.ts"
  ],
  "concurrency": 6,
  "timeoutMS": 15000,
  "timeoutFactor": 2,
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/rate.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/rate.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
