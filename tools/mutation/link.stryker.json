{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-concurrency=1 slices/link/test/occupancy.test.ts slices/link/test/port.test.ts slices/link/test/property.test.ts slices/link/test/scenarios.test.ts"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "disableTypeChecks": false,
  "mutate": [
    "slices/link/src/occupancy.ts",
    "slices/link/src/state.ts:169-330",
    "slices/link/src/state.ts:353-356"
  ],
  "concurrency": 6,
  "timeoutMS": 15000,
  "timeoutFactor": 2,
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/link.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/link.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
