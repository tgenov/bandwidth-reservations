{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-concurrency=1 \"slices/account/money/test/*.test.ts\""
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "disableTypeChecks": false,
  "mutate": [
    "slices/account/money/src/webster.ts",
    "slices/account/money/src/money.ts",
    "slices/account/money/src/ledger/accounts.ts",
    "slices/account/money/src/ledger/decide.ts",
    "slices/account/money/src/ledger/templates.ts",
    "slices/account/money/src/settlement/settlement.ts",
    "slices/account/money/src/settlement/deviation.ts"
  ],
  "concurrency": 6,
  "timeoutMS": 30000,
  "timeoutFactor": 2,
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/money.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/money.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
