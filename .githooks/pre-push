#!/usr/bin/env bash
# Before a push: `npm run check` (boundaries, every type check, every unit test). Integration tests run in
# `npm run ci`, not here. Skip once with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: npm run check"
npm run -s check || { printf '\npre-push: FAILED: npm run check. Fix it before you push.\n' >&2; exit 1; }
echo "pre-push: ok"
