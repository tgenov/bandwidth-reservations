#!/usr/bin/env bash
# Before a commit: the slice boundary check, ESLint on the staged workspaces, then the type check and unit tests
# of each workspace with staged changes. A change in platform/, contracts/, the root package files or the lint
# config type-checks every workspace and runs only the contract suites (`test:contracts`), not every unit test.
# The hook never runs integration tests or the full harness.
# Skip once with `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
fail() { printf '\npre-commit: FAILED: %s\nFix it, or run `npm run check` to see all.\n' "$1" >&2; exit 1; }

ALL=(platform link sec account rate)
broad=0
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0

targets=()
add() { [[ " ${targets[*]-} " == *" $1 "* ]] || targets+=("$1"); }
while IFS= read -r path; do
  case "$path" in
    platform/*|contracts/*|package.json|package-lock.json|tsconfig*.json|eslint.config.js|tools/eslint/*) broad=1; targets=("${ALL[@]}"); break ;;
    slices/*) s=${path#slices/}; s=${s%%/*}
              if [ "$(npm pkg get "scripts.typecheck:$s")" != "{}" ]; then add "$s"; else broad=1; targets=("${ALL[@]}"); break; fi ;;
  esac
done <<< "$staged"

echo "pre-commit: check:boundaries"
npm run -s check:boundaries || fail "check:boundaries"
lint_paths=()
for w in "${targets[@]-}"; do
  case "$w" in
    '') ;;
    platform) lint_paths+=(platform contracts) ;;
    *) lint_paths+=("slices/$w") ;;
  esac
done
if [ ${#lint_paths[@]} -gt 0 ]; then
  echo "pre-commit: eslint ${lint_paths[*]}"
  npx --no-install eslint "${lint_paths[@]}" || fail "lint"
fi
if [ "$broad" = 1 ]; then
  echo "pre-commit: typecheck + test:contracts"
  npm run -s typecheck || fail "typecheck"
  out=$(npm run -s test:contracts 2>&1) || { printf '%s\n' "$out" | tail -40; fail "test:contracts"; }
else
  for w in "${targets[@]-}"; do
    [ -n "$w" ] || continue
    echo "pre-commit: typecheck:$w + test:$w"
    npm run -s "typecheck:$w" || fail "typecheck:$w"
    out=$(npm run -s "test:$w" 2>&1) || { printf '%s\n' "$out" | tail -40; fail "test:$w"; }
  done
fi
echo "pre-commit: ok (${targets[*]:-no workspace changed})"
