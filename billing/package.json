  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
